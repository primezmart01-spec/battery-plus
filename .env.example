# Application Environment Configuration for Chaudhary Battery And UPS F10
# Note: Keep secrets out of source control. Copy to .env for local runtime.

# Application Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Authentication & Session Security (Must be cryptographically strong, min 32 chars)
JWT_SECRET=change_this_to_a_secure_random_32_plus_character_string_for_jwt
SESSION_SECRET=change_this_to_a_secure_random_32_plus_character_string_for_session

# Payment Gateway Configuration (Supports Pakistani Gateways / COD / Abstraction Layer)
# Supported options: 'cod' (Cash on Delivery), 'payfast', 'jazzcash', 'easypaisa', 'bank_transfer', 'stripe'
PAYMENT_PROVIDER=cod
PAYMENT_MODE=test
PAYMENT_MERCHANT_ID=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email SMTP Provider Configuration (Transactional notifications & receipts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Chaudhary Battery And UPS F10"
SMTP_FROM_EMAIL="sales@chaudharybattery.pk"

# File Upload Storage Directory
STORAGE_UPLOAD_DIR="./uploads"

# Optional Cloud Storage / S3 / R2 Bucket (if configured)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

